{
  "manifest_version": 3,
  "name": "Chess Utility",
  "description": "Type chess moves instead of dragging them — on chess.com, Chessable, lichess and xiangqi — plus keyboard navigation on any site.",
  "version": "1.21.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "js": [
        "scripts/keyboard-move/clickable-probe.js"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://www.chessable.com/*",
        "https://chessable.com/*",
        "https://lichess.org/*",
        "https://www.lichess.org/*",
        "https://www.clubxiangqi.com/*",
        "https://clubxiangqi.com/*"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "js": [
        "scripts/find_position_in_course.js"
      ],
      "matches": [
        "https://www.chessable.com/explore/*",
        "https://chessable.com/explore/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "scripts/keyboard-move/vendor/chess.js",
        "scripts/keyboard-move/matcher.js",
        "scripts/keyboard-move/hud.js",
        "scripts/keyboard-move/chesscom.js",
        "scripts/keyboard-move/main.js"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "js": [
        "scripts/keyboard-move/vendor/chess.js",
        "scripts/keyboard-move/matcher.js",
        "scripts/keyboard-move/hud.js",
        "scripts/keyboard-move/chessable.js",
        "scripts/keyboard-move/main.js"
      ],
      "matches": [
        "https://www.chessable.com/mt1/*",
        "https://chessable.com/mt1/*"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "js": [
        "scripts/keyboard-move/chessable-relay.js"
      ],
      "matches": [
        "https://www.chessable.com/explore/*",
        "https://chessable.com/explore/*"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "js": [
        "scripts/keyboard-move/matcher.js",
        "scripts/keyboard-move/hud.js",
        "scripts/keyboard-move/clubxiangqi.js",
        "scripts/keyboard-move/main.js"
      ],
      "matches": [
        "https://www.clubxiangqi.com/webapp/*",
        "https://clubxiangqi.com/webapp/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "scripts/keyboard-move/vendor/chess.js",
        "scripts/keyboard-move/matcher.js",
        "scripts/keyboard-move/hud.js",
        "scripts/keyboard-move/lichess.js",
        "scripts/keyboard-move/main.js"
      ],
      "matches": [
        "https://lichess.org/*",
        "https://www.lichess.org/*"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "js": [
        "scripts/keyboard-move/settings-bridge.js"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://www.chessable.com/mt1/*",
        "https://chessable.com/mt1/*"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "js": [
        "scripts/keyboard-move/hints.js",
        "scripts/keyboard-move/scroll.js"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://www.chessable.com/*",
        "https://chessable.com/*",
        "https://lichess.org/*",
        "https://www.lichess.org/*",
        "https://www.clubxiangqi.com/*",
        "https://clubxiangqi.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
