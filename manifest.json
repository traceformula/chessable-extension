{
  "manifest_version": 3,
  "name": "Chess Utility Extension",
  "description": "Keyboard move input for chess.com, plus Chessable helpers",
  "version": "1.2.4",
  "action": {
    "default_popup": "main.html",
    "default_icon": "hi.png"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/find_position_in_course.js"
      ],
      "matches": [
        "https://www.chessable.com/explore/*",
        "https://chessable.com/explore/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "scripts/keyboard-move/vendor/chess.js",
        "scripts/keyboard-move/matcher.js",
        "scripts/keyboard-move/hud.js",
        "scripts/keyboard-move/chesscom.js",
        "scripts/keyboard-move/main.js"
      ],
      "matches": [
        "https://www.chess.com/*"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
